# ===================================================================
# Utservio Gmail Communication Data Collection Engine
# Environment Configuration Template
# ===================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ===================================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=email-attachments

# --- Runtime ---
ENVIRONMENT=development

# --- Scheduler ---
ENABLE_SCHEDULER=false
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=15
SCHEDULER_TIMEZONE=UTC
MAX_SYNC_INSTANCES=1
SYNC_MISFIRE_GRACE_SECONDS=300
SYNC_LOCK_TTL_MINUTES=20

# --- Security ---
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_SECRETS_FILE=secrets/credentials.json
GOOGLE_TOKEN_FILE=secrets/token.json
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# --- Sync Limits ---
MAX_EMAILS_PER_SYNC=50
MAX_ATTACHMENTS_PER_SYNC=10
MAX_ATTACHMENT_SIZE_MB=15
